{
  "cli": {
    "version": ">=21.0.2",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "stage": {
      "android": {
        "buildType": "apk",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "distribution": "internal",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-54"
      },
      "autoIncrement": false,
      "distribution": "store",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "environment": "production",
      "node": "20.19.4",
      "credentialsSource": "remote"
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "autoIncrement": false,
      "env": {
        "MBW_BUILD_KIND": "production-apk",
        "MBW_PRODUCTION_AFTER_FINAL_STAGE_CLEAN": "true",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "playAab": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "MBW_ARTIFACT_KIND": "AAB"
      }
    },
    "stage-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "autoIncrement": false,
      "env": {
        "MBW_BUILD_KIND": "FINAL_MBW_APK_24E41N4B_FIXED_PARSE_IMPORT",
        "MBW_FINAL_STAGE_FIRST": "true",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "MBW_BUILD_KIND": "GOLDEN_GLOBAL_RELEASE_CERTIFICATION_APK",
        "MBW_ARTIFACT_KIND": "APK"
      }
    },
    "golden-apk": {
      "distribution": "internal",
      "environment": "production",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_MBW_RELEASE_CHANNEL": "production",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "play-aab": {
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_MBW_RELEASE_CHANNEL": "production",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "image": "sdk-54"
      },
      "node": "20.19.4",
      "credentialsSource": "remote"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "image": "sdk-54"
      },
      "node": "20.19.4"
    }
  },
  "submit": {
    "production": {}
  }
}
